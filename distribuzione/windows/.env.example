TESLA_VERSION=1.0.0

# Credenziali dell'app Tesla developer del cliente
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_VEHICLE_VIN=
TESLA_REDIRECT_URI=http://localhost:8080/callback
TESLA_OAUTH_SCOPES=openid offline_access vehicle_device_data vehicle_cmds vehicle_charging_cmds vehicle_location
TESLA_TELEMETRY_ENABLED=false

# Account Tailscale del cliente; la chiave monouso serve solo al primo login
TS_AUTHKEY=
TAILSCALE_HOSTNAME=tesla-telemetry

# Credenziali interne, generate da "tesla.cmd prepara"; non cambiarle dopo il primo avvio
MQTT_USERNAME=tesla_nodered
MQTT_PASSWORD=__GENERATE__
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_USER=tesla_nodered
MYSQL_PASSWORD=__GENERATE__
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=__GENERATE__
INFLUX_ADMIN_TOKEN=__GENERATE__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE__
