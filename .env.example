# Tesla Fleet API OAuth Example .env file
# ⚠️  DO NOT COMMIT THIS FILE WITH REAL VALUES
# Copy this file to .env and fill in your credentials
#
# Your .env file will be automatically ignored by git (.gitignore)
# but NEVER manually commit it with real credentials

# Fleet API Credentials (from https://developer.tesla.com)
# Get these from your Tesla Developer Account
# ⚠️  KEEP THESE SECRET - Do not share or commit to git
TESLA_CLIENT_ID=your_client_id_from_developer_tesla_com
TESLA_CLIENT_SECRET=your_client_secret_keep_this_secret
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your Vehicle VIN
# Find in Tesla: Settings > Software > VIN
# Example format: 5YJ3E1EA1KF123456
# ⚠️  KEEP THIS SECRET - Reveals your vehicle
TESLA_VEHICLE_VIN=your_vehicle_vin_here

# Mosquitto MQTT and MySQL credentials
# Replace these placeholders with long, unique passwords before starting the stack.
MQTT_USERNAME=tesla_nodered
MQTT_PASSWORD=replace_with_a_long_random_mqtt_password
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_mysql_root_password
MYSQL_USER=tesla_nodered
MYSQL_PASSWORD=replace_with_a_long_random_mysql_password

# Optional Fleet Telemetry receiver. Preparing files does not activate the car.
TESLA_TELEMETRY_ENABLED=false
TESLA_TELEMETRY_HOSTNAME=
TESLA_TELEMETRY_PORT=443
TESLA_TELEMETRY_DIR=config/telemetry
TESLA_TELEMETRY_FIELDS=telemetry/vehicle-fields.json
# Set these to `id -u` and `id -g` of the owner of the telemetry files (nonroot).
TELEMETRY_UID=1000
TELEMETRY_GID=1000
# Keep existing scopes by default. Append vehicle_location and authorize again
# before explicitly applying the extended GPS profile. See docs/FLEET_TELEMETRY.md.
TESLA_OAUTH_SCOPES="openid offline_access vehicle_device_data vehicle_cmds vehicle_charging_cmds"
