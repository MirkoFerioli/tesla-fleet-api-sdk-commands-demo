[
  {
    "id": "tesla-mqtt-mysql-flow",
    "type": "tab",
    "label": "Tesla MQTT to MySQL",
    "disabled": false,
    "info": "Stores JSON MQTT messages from tesla/# in the MySQL mqtt_messages table."
  },
  {
    "id": "tesla-mqtt-input",
    "type": "mqtt in",
    "z": "tesla-mqtt-mysql-flow",
    "name": "Subscribe tesla/#",
    "topic": "tesla/#",
    "qos": "0",
    "datatype": "auto",
    "broker": "tesla-mosquitto-config",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 120,
    "wires": [["tesla-mqtt-prepare"]]
  },
  {
    "id": "tesla-mqtt-prepare",
    "type": "function",
    "z": "tesla-mqtt-mysql-flow",
    "name": "Prepare parameterized insert",
    "func": "const mqttTopic = msg.topic;\nconst jsonPayload = JSON.stringify(msg.payload ?? null);\nmsg.topic = \"INSERT INTO mqtt_messages (topic, payload) VALUES (?, ?)\";\nmsg.payload = [mqttTopic, jsonPayload];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 120,
    "wires": [["tesla-mysql-insert"]]
  },
  {
    "id": "tesla-mysql-insert",
    "type": "mysql",
    "z": "tesla-mqtt-mysql-flow",
    "mydb": "tesla-mysql-config",
    "name": "Insert MQTT message",
    "x": 700,
    "y": 120,
    "wires": [[]]
  },
  {
    "id": "tesla-mosquitto-config",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered-tesla-mqtt",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthRetain": "false",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closeRetain": "false",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willRetain": "false",
    "willPayload": ""
  },
  {
    "id": "tesla-mysql-config",
    "type": "MySQLdatabase",
    "name": "Tesla MySQL",
    "host": "mysql",
    "port": "3306",
    "db": "tesla",
    "tz": "UTC",
    "charset": "UTF8MB4"
  }
]